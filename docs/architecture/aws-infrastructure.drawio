          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ci-steps" value="Pipeline summary&#xa;1. Developer pushes to feature/* → opens PR.&#xa;2. pr-validate.yml runs terraform fmt + validate + plan against DEV state. PR review required.&#xa;3. Merge to dev → deploy-dev.yml plans + applies to AWS DEV via OIDC role dbks-infra-iam-role-gha-deploy.&#xa;4. Open PR dev → main, second review.&#xa;5. Merge to main → deploy-prod.yml plans + waits for GitHub Environment 'prod' approval, then applies to AWS PROD via the same OIDC role.&#xa;6. State + lock are isolated per env (same bucket dbks-infra-s3-tf-state, different keys; same DynamoDB table dbks-infra-tf-state-lock)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10" parent="1" vertex="1">
